class CuentaBancaria:
    def __init__(self, titular, numero_cuenta, saldo_inicial=0.0):
        """Constructor de la clase CuentaBancaria."""
        self.titular = titular
        self.numero_cuenta = numero_cuenta
        self.saldo = max(0.0, saldo_inicial)

    def depositar(self, cantidad):
        """Suma una cantidad positiva al saldo de la cuenta."""
        if cantidad > 0:
            self.saldo += cantidad
            print(f" Depósito exitoso: Se han depositado ${cantidad:,.2f}.")
            print(f"   Saldo actual: ${self.saldo:,.2f}")
        else:
            print(" Error: La cantidad a depositar debe ser mayor que cero.")

    def retirar(self, cantidad):
        """Resta una cantidad al saldo validando que existan fondos."""
        if cantidad > 0:
            if self.saldo >= cantidad:
                self.saldo -= cantidad
                print(f" Retiro exitoso: Se han retirado ${cantidad:,.2f}.")
                print(f"   Saldo actual: ${self.saldo:,.2f}")
            else:
                print(f"Error: Fondos insuficientes. No puedes retirar ${cantidad:,.2f} porque tu saldo actual es de ${self.saldo:,.2f}.")
        else:
            print("Error: La cantidad a retirar debe ser mayor que cero.")

    def mostrar_informacion(self):
        """Muestra en pantalla el estado actual de la cuenta."""
        print("\n" + "="*35)
        print("       ESTADO DE LA CUENTA        ")
        print("="*35)
        print(f"Titular:          {self.titular}")
        print(f"Número de Cuenta: {self.numero_cuenta}")
        print(f"Saldo Actual:     ${self.saldo:,.2f}")
        print("="*35 + "\n")


