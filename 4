# BLOQUE DE EJECUCIÓN Y PRUEBAS
# =====================================================================
if __name__ == "__main__":
    print("=== PRUEBAS DE LA CLASE LIBRO ===")
    
    libro_uno = Libro("Cien años de soledad", "Gabriel García Márquez", 1967)
    libro_dos = Libro("Fiebre de canal", "Héctor Abad Faciolince", 2024)

    print(libro_uno.obtener_descripcion())
    if libro_uno.es_clasico():
        print(" Resultado: Este libro ya es considerado un clásico.")
    else:
        print("⏱️ Resultado: Aún no es considerado un clásico.")

    print("-" * 40)

    print(libro_dos.obtener_descripcion())
    if libro_dos.es_clasico():
        print(" Resultado: Este libro ya es considerado un clásico.")
    else:
        print(" Resultado: Aún no es considerado un clásico (es relativamente nuevo).")
