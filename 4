# =====================================================================
# CLASE: LIBRO
# =====================================================================
class Libro:
    def __init__(self, titulo, autor, año_publicacion):
        """Constructor de la clase Libro."""
        self.titulo = titulo
        self.autor = autor
        self.año_publicacion = año_publicacion

    def obtener_descripcion(self):
        """Devuelve una cadena de texto con la descripción detallada del libro."""
        return f"'{self.titulo}' escrito por {self.autor} (Publicado en {self.año_publicacion})."

    def es_clasico(self):
        """Verifica si el libro tiene más de 50 años desde su publicación."""
        año_actual = 2026
        antiguedad = año_actual - self.año_publicacion
        return antiguedad > 50


