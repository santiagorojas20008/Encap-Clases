class Rectangulo:
    def __init__(self, base, altura):
        """
        Constructor de la clase Rectángulo.
        :param base: Largo de la base del rectángulo.
        :param altura: Largo de la altura del rectángulo.
        """
        self.base = base
        self.altura = altura

    def calcular_area(self):
        """Calcula el área del rectángulo (base * altura)."""
        return self.base * self.altura

    def calcular_perimetro(self):
        """Calcula el perímetro del rectángulo (2 * (base + altura))."""
        return 2 * (self.base + self.altura)



if __name__ == "__main__":
 
    mi_rectangulo = Rectangulo(base=5, altura=3)

  
    area_resultado = mi_rectangulo.calcular_area()
    perimetro_resultado = mi_rectangulo.calcular_perimetro()


    print("====================================")
    print("       DATOS DEL RECTÁNGULO         ")
    print("====================================")
