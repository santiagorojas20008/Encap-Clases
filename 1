class Auto:
    def __init__(self, marca, modelo, anio):
        # Atributos privados
        self.__marca = marca
        self.__modelo = modelo
        self.__anio = anio

 
    def get_marca(self):
        return self.__marca

    def get_modelo(self):
        return self.__modelo

    def get_anio(self):
        return self.__anio


    def set_marca(self, marca):
        self.__marca = marca

    def set_modelo(self, modelo):
        self.__modelo = modelo

    def set_anio(self, anio):
        if anio > 0:  # Validación simple
            self.__anio = anio
        else:
            print("El año debe ser válido")

    def mostrar_info(self):
        return f"Auto: {self.__marca} {self.__modelo} ({self.__anio})"



auto1 = Auto("Toyota", "Corolla", 2022)

print(auto1.mostrar_info())


auto1.set_anio(2023)
print(auto1.mostrar_info())
